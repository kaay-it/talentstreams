alt sentCampaignId === null (первая настоящая отправка)
  app -> sh_mail : markMailingListSent(listId, campaignId)\nUPDATE mailingLists SET sentCampaignId = ...
  sh_mail --> app : OK
  app -> sh_cands : getCandidates() — резолвит id по каждому\nкандидату выпуска (все статусы)
  sh_cands --> app : кандидаты

  loop по каждому кандидату из candidateIds
    app -> sh_mail : getMailingListsForCandidate(id)\nwhole история выпусков кандидата
    sh_mail --> app : история, с sentCampaignId на каждой записи
    app -> app : sentBefore = history.filter(sentCampaignId !== null).length\n(TASK-40 — больше НЕ сверка с именами кампаний/campaignNames)
    alt sentBefore + 1 == 1
      app -> sh_cands : updateCandidateStatus(id, "Активный", today + 2 недели)
    else sentBefore + 1 == 2
      app -> sh_cands : updateCandidateStatus(id, "Активный", today + 3 месяца)
    else sentBefore + 1 >= 3
      app -> sh_cands : updateCandidateStatus(id, "Не публиковать", today + 10 лет)
      note right of sh_cands
        Терминальный статус — кандидат отправлен уже 3 раза,
        дальше getActiveCandidates() исключает его из всех
        подборок насовсем. Редактор может вручную вернуть
        статус «Активный» кнопкой «Подтвердить» на
        странице «Кандидаты».
      end note
    end
  end
else повторная отправка
  note over app
    sentCampaignId уже не NULL — markMailingListSent() и счётчик
    отправок кандидатов не трогаем, иначе пауза сдвигалась бы
    заново при каждом ресенде
  end note
end

app --> editor : «Кампания #{campaignId} запущена»\n(revalidatePath /editor)

== 5а. SendPulse доставляет письма подписчикам ==

sp_camp -> employer : Email «Talent Stream: Finance — выпуск 21.07.2026»\nСсылка: /list/f04a9b3e-…?e={{employer_token}}\n({{Имя}} и {{employer_token}} заменяются на значения получателя)

note right of sp_camp
  Книга получателей — одноразовая (§5, если выбраны «Выбранные
  получатели», TASK-40) либо книга всего стрима. Каждый получатель
  видит ссылку со своим токеном — подборка персонализирована и
  закрыта от посторонних; что именно он увидит по ссылке, решает
  resolveMailingListForEmployer() на /list/[listId] (§6 ниже), не
  состав этой книги.
end note

== 5б. Фоллоу-ап работодателям после рассылки (TASK-46) ==

note over app, neonFollow
  Запуск: ЕЖЕДНЕВНЫЙ крон (в отличие от еженедельного §2д —
  каждый выпуск сидит в своём окне [3, 21] дней после отправки
  только один раз, ежедневная проверка ловит его близко к
  границе) ИЛИ «Отправить сейчас» в ReleaseFollowUpSection.
end note

app -> sh_mail : getMailingLists()\nвсе отправленные выпуски (sentCampaignId != null)
sh_mail --> app : [{ listId, stream, sentCampaignId }, …]

loop по каждому отправленному выпуску
  app -> sp_camp : getCampaignSendDate(sentCampaignId)\nGET /campaigns/{id} → send_date
  sp_camp --> app : sendDate
  alt daysSinceSend вне [3, 21] дней
    app -> app : пропустить — либо рано, либо слишком поздно\n(защита от обработки всего исторического бэклога\nпри первом/запоздавшем запуске)
  else в окне
    app -> sh_mail : getReleaseAudience(listId, stream)\nузкая аудитория (TASK-40), если есть, иначе весь\nподтверждённый стрим — кто реально ПОЛУЧИЛ письмо
    sh_mail --> app : [employer, …]
    app -> neonDb : getEmployerTokensWithRequestForList(listId)\nкто уже отправил заявку ИМЕННО по этому выпуску
    neonDb --> app : Set<employerToken>
    app -> neonFollow : getEvaluatedFollowUpKeys([listId])\nпары (выпуск, работодатель), уже решённые когда-либо
    neonFollow --> app : Set<"listId|employerToken">

    loop по каждому ещё не решённому работодателю аудитории
      app -> sp_camp : getCampaignEmailStatus(sentCampaignId, employer.email)\nGET /campaigns/{id}/email/{email} — ЕДИНСТВЕННОЕ число\n(похожий путь с emails во множественном числе существует\nи выглядит правдоподобно, но отдаёт 404 на каждый запрос —\nреальная ошибка, пойманная живым драй-раном до прод-отправки)
      sp_camp --> app : { detailStatus }\nopened = detailStatus >= 3 (3 Opened, 4 Link redirected)

      alt работодатель уже отправил заявку по этому выпуску
        app -> neonFollow : recordFollowUpOutcome(listId, token, "skipped")\nНЕЗАВИСИМО от opened — заявка перевешивает open-tracking\nпиксель (ненадёжен: блокировка картинок даёт ложный\n«не открыл»; приоритет исправлен после реального бага,\nпойманного тем же драй-раном)
        neonFollow --> app : OK
      else opened == true
        app -> sp_smtp : sendTransactionalEmail(employer, "Помогите нам\nсделать подборки точнее", buildFollowUpFeedbackEmailHtml(), partner@)
        sp_smtp --> app : 200
        app -> neonFollow : recordFollowUpOutcome(listId, token, "feedback")
        neonFollow --> app : OK
      else opened == false
        app -> sp_smtp : sendTransactionalEmail(employer, "Напоминаем о\nновой подборке — {stream}", buildFollowUpReminderEmailHtml(\n{ employerName, streamName, listUrl: /list/listId?e=token }), partner@)\nТа же персональная ссылка, что была в исходном письме кампании
        sp_smtp --> app : 200
        app -> neonFollow : recordFollowUpOutcome(listId, token, "reminder")
        neonFollow --> app : OK
      end
    end
  end
end

app -> neonAuto : recordReleaseFollowUpRun({ triggeredBy, releasesChecked,\nemployersEvaluated, feedbackSent, reminderSent, failed })\nINSERT INTO releaseFollowUpRuns
neonAuto --> app : OK
app --> editor : История запусков на /editor/settings обновлена

note right of neonFollow
  releaseFollowUps — unique(listId, employerToken): каждая пара
  решается один раз НАВСЕГДА, независимо от того, сколько раз
  потом отработает ежедневный крон. Telegram-напоминание для
  группы «не открыл» (из исходного запроса пользователя) НЕ
  реализовано — текст помечен «на согласование», отложено.
end note

== 6. Работодатель просматривает подборку (TASK-44 — подборка отделена от выпуска) ==

note over app, sh_mail
  ?e= ВСЕГДА резолвится «как у этого работодателя» — личная
  подборка без фильтра, если она на него заведена, иначе дефолтная
  с фильтром — НЕЗАВИСИМО от того, передан ли одновременно ?secret=
  (раньше secret при наличии e ошибочно отключал фильтр целиком).
  ?secret= без e — отдельная, более узкая ветка: дефолтная подборка
  без фильтра, либо «подборка не готова», если дефолтной нет вовсе.
  Ни e, ни secret — 404 сразу, до единого запроса к БД.
end note

alt ?e=[token] — персонализированный доступ работодателя
employer -> app : GET /list/f04a9b3e-…?e=8f3a1c…
app -> sh_mail : getMailingList("f04a9b3e-…")\nзаголовок mailingLists + ПРИСОЕДИНЁННЫЕ к этому listId подборки\n(selections/selectionEntries/selectionEmployers) + джойн на\ngetCandidates() — ВСЕ статусы, не getActiveCandidates(): историческая\nпринадлежность к уже отправленному выпуску не зависит от статуса\nкандидата на момент просмотра
sh_mail --> app : { stream, date,\n  default: ResolvedSelection | null,\n  personal: ResolvedSelection[] }
app -> sh_emp : getEmployerByToken("8f3a1c…")
sh_emp --> app : employer | null (404, если не найден)
app -> app : resolveMailingListForEmployer(mailingList, token)\nличная (если employerToken в её selectionEmployers) БЕЗ фильтра,\nиначе дефолтная
alt резолвилась личная подборка
  app -> app : entries = resolved.entries (без фильтра —\nменеджер уже решил вручную, filterCandidatesForEmployer\nсюда вообще не допускается)
else резолвилась дефолтная
  app -> app : filterCandidatesForEmployer(entries, employer)\n(excludedCompanies/excludedStreams, гео: countryPrimary/\ncountryDesired ∩ employer.country+additionalCountries;\n«Любая» → без гео-фильтра; нет данных о стране → скрыть)
else резолв вернул null (ни личной, ни дефолтной)
  app -> app : ready = false
end
app -> neonStreams : getStreamsDetailed() — типы стримов для тегов (TASK-27)
neonStreams --> app : [{ name, type }, …]
app --> employer : ready → анонимные карточки (должность, уровень,\nстрана, summary, industry/functional-теги), кнопка «Хочу связаться»\n+ блок «Не нашли подходящих?» (GeneralInquiryButton) + ссылка\nTelegram-бота; !ready → «Подборка для вас пока не готова» (HTTP 200)
else ?secret=[EDITOR_SECRET] без ?e= — доступ редактора
editor -> app : GET /list/f04a9b3e-…?secret=…
app -> sh_mail : getMailingList("f04a9b3e-…") (тот же запрос, что выше)
sh_mail --> app : { stream, date, default, personal }
alt mailingList.default существует
  app -> app : entries = default.entries — БЕЗ фильтра,\nредактор видит дефолтную подборку как есть
else дефолтной нет вовсе (есть только ограниченные)
  app -> app : ready = false — «подборка не готова» и у редактора тоже,\nвалидный случай, если ограниченные покрывают весь стрим
end
app --> editor : Та же разметка, что у работодателя — просто без employerToken\n(блок «Не нашли подходящих?»/Telegram не показываются — нужен employerToken)
else ни ?e=, ни ?secret= — 404 сразу
employer -> app : GET /list/f04a9b3e-… (без параметров)
app --> employer : 404 Not Found (до единого запроса к БД)
end

note over app, employer
  Страница noindex — недоступна поисковым роботам.
  Прямой просмотр ОДНОЙ подборки саму по себе, независимо от
  привязки к выпуску (инструмент редактора «Подборка» →
  «Просмотреть →», только ?secret=, без e= вовсе и без
  гео-фильтра/исключений) — отдельная страница
  /selection/[selectionId], не этот сценарий.
end note

